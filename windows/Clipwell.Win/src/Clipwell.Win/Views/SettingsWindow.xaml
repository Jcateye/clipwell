<Window x:Class="Clipwell.Win.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Clipwell Settings"
        Width="480" Height="520"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <TextBlock Text="{Binding HotkeyStatusMessage}" Foreground="OrangeRed"
                       VerticalAlignment="Center" Margin="0,0,12,0" />
            <Button Content="Save" Padding="20,6" Command="{Binding SaveCommand}" Click="OnSaveClicked" />
        </StackPanel>

        <TabControl>
            <TabItem Header="General">
                <StackPanel Margin="12">
                    <CheckBox Content="Launch at login" IsChecked="{Binding LaunchAtLoginEnabled}" Margin="0,4" />
                    <CheckBox Content="Pause clipboard monitoring" IsChecked="{Binding MonitoringPaused}" Margin="0,4" />
                    <CheckBox Content="Close drawer after restoring a clip" IsChecked="{Binding AutoCloseDrawerEnabled}" Margin="0,4" />
                    <TextBlock Text="Drawer edge" Margin="0,12,0,4" />
                    <ComboBox SelectedValuePath="Content" SelectedValue="{Binding DrawerEdge}" Width="120" HorizontalAlignment="Left">
                        <ComboBoxItem Content="left" />
                        <ComboBoxItem Content="right" />
                    </ComboBox>
                    <TextBlock Text="Drawer width" Margin="0,12,0,4" />
                    <TextBox Text="{Binding DrawerWidth}" Width="120" HorizontalAlignment="Left" />
                </StackPanel>
            </TabItem>

            <TabItem Header="History">
                <StackPanel Margin="12">
                    <TextBlock Text="Maximum history items" Margin="0,4" />
                    <TextBox Text="{Binding HistoryMaxCount}" Width="120" HorizontalAlignment="Left" />
                    <CheckBox Content="Skip consecutive duplicates" IsChecked="{Binding DedupConsecutiveEnabled}" Margin="0,12,0,4" />
                    <TextBlock Text="Ignored apps (one per line)" Margin="0,12,0,4" />
                    <TextBox Text="{Binding IgnoredAppListText}" AcceptsReturn="True" Height="80"
                             VerticalScrollBarVisibility="Auto" />
                    <TextBlock Text="Ignored file extensions (comma separated)" Margin="0,12,0,4" />
                    <TextBox Text="{Binding IgnoredFileExtensionsText}" />
                </StackPanel>
            </TabItem>

            <TabItem Header="Hotkey">
                <StackPanel Margin="12">
                    <TextBlock Text="Toggle drawer" Margin="0,4" />
                    <TextBox x:Name="HotkeyBox" Text="{Binding HotkeyDisplayText, Mode=OneWay}" IsReadOnly="True"
                             Width="200" HorizontalAlignment="Left"
                             PreviewKeyDown="OnHotkeyBoxKeyDown"
                             ToolTip="Click and press the new key combination" />
                    <TextBlock Text="Click the box and press a combination like Ctrl+Shift+V."
                               Foreground="Gray" Margin="0,8,0,0" TextWrapping="Wrap" />
                    <CheckBox Content="Auto-paste after restoring a clip" IsChecked="{Binding AutoPasteEnabled}" Margin="0,16,0,4" />
                </StackPanel>
            </TabItem>

            <TabItem Header="AI">
                <StackPanel Margin="12">
                    <CheckBox Content="Enable AI features (translate / summarize / rewrite)"
                              IsChecked="{Binding ProAIEnabled}" Margin="0,4" />
                    <TextBlock Text="OpenAI-compatible base URL" Margin="0,12,0,4" />
                    <TextBox Text="{Binding ProAIBaseUrl}" />
                    <TextBlock Text="API key" Margin="0,12,0,4" />
                    <TextBox Text="{Binding ProAIApiKey}" />
                    <TextBlock Text="Model" Margin="0,12,0,4" />
                    <TextBox Text="{Binding ProAIModel}" Width="200" HorizontalAlignment="Left" />
                    <TextBlock Text="Translation target language" Margin="0,12,0,4" />
                    <TextBox Text="{Binding ProTranslationTargetLanguage}" Width="200" HorizontalAlignment="Left" />
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Content="Test connection" Padding="12,4" Command="{Binding TestAIConnectionCommand}" />
                        <TextBlock Text="{Binding AiConnectionStatus}" VerticalAlignment="Center" Margin="12,0,0,0"
                                   TextWrapping="Wrap" MaxWidth="240" />
                    </StackPanel>
                </StackPanel>
            </TabItem>

            <TabItem Header="Pro">
                <StackPanel Margin="12">
                    <CheckBox Content="Enable Pro features (OCR, vocabulary)" IsChecked="{Binding ProEnabled}" Margin="0,4" />
                    <CheckBox Content="Auto-OCR copied images" IsChecked="{Binding AutoOcrImagesEnabled}" Margin="0,4" />
                    <CheckBox Content="Vocabulary collection" IsChecked="{Binding ProVocabularyEnabled}" Margin="0,4" />
                    <TextBlock Text="OCR languages (BCP-47 tags, comma separated)" Margin="0,12,0,4" />
                    <TextBox Text="{Binding ProOcrLanguagesText}" Width="240" HorizontalAlignment="Left" />
                    <TextBlock Text="Screenshot OCR hotkey: Alt+Shift+R" Foreground="Gray" Margin="0,16,0,0" />
                </StackPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
